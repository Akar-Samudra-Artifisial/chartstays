  "study": {
    "protocolSection": {
      "identificationModule": {
        "nctId": "NCT07595549",
        "briefTitle": "A Study to Learn About the Study Medicine Called Berobenatide (PF-08653944) in People With Overweight or Obesity"
      },
      "statusModule": {
        "overallStatus": "RECRUITING",
        "startDateStruct": {
          "date": "2026-06-10"
        },
        "primaryCompletionDateStruct": {
          "date": "2028-05-04"
        },
        "lastUpdatePostDateStruct": {
