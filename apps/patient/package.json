{
  "name": "@chartstays/patient",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "vendor": "node scripts/vendor-runtime.mjs",
    "demo-data": "node scripts/copy-demo-data.mjs",
    "configure-nodes": "node scripts/configure-nodes.mjs",
    "build:network": "node ../../vendor/agentic-web/skills/agentify-website/scripts/build_network.mjs agent/patient_navigator.hocon --manifest public/agent-manifest.json --runtime public/runtime --out public/patient_navigator.network.json",
    "check:network": "node scripts/configure-nodes.mjs --check && pnpm run build:network --check",
    "vendor-webllm": "node scripts/vendor-webllm.mjs && node scripts/fetch-webllm-libs.mjs",
    "pin-webllm": "node scripts/pin-webllm.mjs",
    "prebuild": "pnpm run vendor && pnpm run vendor-webllm && pnpm run demo-data && pnpm run configure-nodes && pnpm run build:network",
    "build": "next build && node scripts/configure-nodes.mjs --headers",
    "test": "node --test \"test/*.test.mjs\""
  },
  "dependencies": {
    "@chartstays/criteria-schema": "workspace:*",
    "@chartstays/fhir-profile": "workspace:*",
    "@chartstays/matcher": "workspace:*",
    "@mlc-ai/web-llm": "0.2.88",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3"
  }
}
