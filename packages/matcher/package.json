{
  "name": "@chartstays/matcher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deterministic pre-screening: evaluates a ChartStays patient profile against criteria.json documents. Pure TypeScript, no network access, no LLM.",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test \"test/*.test.ts\""
  },
  "dependencies": {
    "@chartstays/criteria-schema": "workspace:*",
    "@chartstays/fhir-profile": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
