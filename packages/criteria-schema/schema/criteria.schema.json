{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chartstays.dev/schema/criteria.schema.json",
  "title": "ChartStays trial criteria",
  "description": "Eligibility criteria of one ClinicalTrials.gov study, structured for deterministic pre-screening. Codes follow the systems used by Synthea FHIR R4 data: SNOMED CT (conditions), LOINC (observations), RxNorm (medications).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "nct_id",
    "title",
    "status",
    "conditions",
    "source",
    "eligibility",
    "structured",
    "free_text",
    "requested_fields_for_inquiry"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "nct_id": { "$ref": "#/definitions/nctId" },
    "title": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "minLength": 1 },
    "conditions": {
      "description": "Condition names exactly as listed on ClinicalTrials.gov (free text, not coded).",
      "type": "array",
      "items": { "type": "string" }
    },
    "source": { "$ref": "#/definitions/source" },
    "eligibility": { "$ref": "#/definitions/eligibility" },
    "structured": {
      "type": "array",
      "items": { "$ref": "#/definitions/criterion" }
    },
    "free_text": {
      "description": "Criteria that could not be mapped to codes. A matcher must report them as unknown.",
      "type": "array",
      "items": { "$ref": "#/definitions/freeTextCriterion" }
    },
    "requested_fields_for_inquiry": {
      "description": "Profile fields the structured criteria need, e.g. age, sex, conditions, labs:<LOINC>, medications.",
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^(age|sex|conditions|medications|labs:[0-9]+-[0-9])$" }
    },
    "curation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method"],
      "properties": {
        "method": { "enum": ["manual", "llm-assisted+manual-review"] },
        "notes": { "type": "string" }
      }
    }
  },
  "definitions": {
    "nctId": { "type": "string", "pattern": "^NCT[0-9]{8}$" },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}(-[0-9]{2})?$" },
    "criterionId": { "type": "string", "pattern": "^(inc|exc)-[0-9]+[a-z]?$" },
    "criterionType": { "enum": ["inclusion", "exclusion"] },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "nct_id", "url", "retrieved", "modified"],
      "properties": {
        "name": { "const": "ClinicalTrials.gov" },
        "nct_id": { "$ref": "#/definitions/nctId" },
        "url": { "type": "string", "pattern": "^https://clinicaltrials\\.gov/study/NCT[0-9]{8}$" },
        "retrieved": { "$ref": "#/definitions/date" },
        "last_update_posted": { "$ref": "#/definitions/date" },
        "modified": {
          "description": "What ChartStays changed relative to the ClinicalTrials.gov record.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "eligibility": {
      "description": "The eligibility module as published on ClinicalTrials.gov, unmodified.",
      "type": "object",
      "additionalProperties": false,
      "required": ["criteria_text", "sex", "minimum_age", "maximum_age"],
      "properties": {
        "criteria_text": { "type": "string" },
        "sex": { "enum": ["ALL", "FEMALE", "MALE"] },
        "minimum_age": { "type": ["string", "null"] },
        "maximum_age": { "type": ["string", "null"] },
        "healthy_volunteers": { "type": ["boolean", "null"] }
      }
    },
    "base": {
      "type": "object",
      "required": ["id", "type", "kind", "label", "source_text"],
      "properties": {
        "id": { "$ref": "#/definitions/criterionId" },
        "type": { "$ref": "#/definitions/criterionType" },
        "label": { "type": "string", "minLength": 1 },
        "source_text": {
          "description": "The criterion text this entry was mapped from, copied from ClinicalTrials.gov.",
          "type": "string",
          "minLength": 1
        },
        "note": { "type": "string" },
        "group": {
          "description": "Logic group id. Criteria with the same group come from one source line and are combined with group_logic instead of the default rule (every inclusion must be met; any met exclusion excludes).",
          "type": "string",
          "pattern": "^(inc|exc)-[0-9]+$"
        },
        "group_logic": {
          "description": "any: one met member satisfies the group (inclusion) or excludes (exclusion). all: every member must be met.",
          "enum": ["all", "any"]
        }
      },
      "dependencies": {
        "group": ["group_logic"],
        "group_logic": ["group"]
      }
    },
    "criterion": {
      "oneOf": [
        { "$ref": "#/definitions/ageCriterion" },
        { "$ref": "#/definitions/sexCriterion" },
        { "$ref": "#/definitions/conditionCriterion" },
        { "$ref": "#/definitions/labCriterion" },
        { "$ref": "#/definitions/medicationCriterion" }
      ]
    },
    "ageCriterion": {
      "allOf": [{ "$ref": "#/definitions/base" }],
      "required": ["min", "max", "unit"],
      "properties": {
        "id": true, "type": true, "label": true, "source_text": true, "note": true,
        "group": true, "group_logic": true,
        "kind": { "const": "age" },
        "min": { "type": ["number", "null"], "minimum": 0 },
        "max": { "type": ["number", "null"], "minimum": 0 },
        "unit": { "const": "years" }
      },
      "additionalProperties": false
    },
    "sexCriterion": {
      "allOf": [{ "$ref": "#/definitions/base" }],
      "required": ["sex"],
      "properties": {
        "id": true, "type": true, "label": true, "source_text": true, "note": true,
        "group": true, "group_logic": true,
        "kind": { "const": "sex" },
        "sex": { "enum": ["female", "male"] }
      },
      "additionalProperties": false
    },
    "conditionCriterion": {
      "allOf": [{ "$ref": "#/definitions/base" }],
      "required": ["codes"],
      "properties": {
        "id": true, "type": true, "label": true, "source_text": true, "note": true,
        "group": true, "group_logic": true,
        "kind": { "const": "condition" },
        "primary": {
          "description": "The study requires the area's main condition (inclusion only). When true, a record without the condition does not meet the criterion; otherwise absence is unknown.",
          "const": true
        },
        "codes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["snomed"],
          "properties": {
            "snomed": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[0-9]{6,18}$" }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "labCriterion": {
      "allOf": [{ "$ref": "#/definitions/base" }],
      "required": ["loinc", "op", "value", "unit"],
      "properties": {
        "id": true, "type": true, "label": true, "source_text": true, "note": true,
        "group": true, "group_logic": true,
        "kind": { "const": "lab" },
        "loinc": { "type": "string", "pattern": "^[0-9]+-[0-9]$" },
        "op": { "enum": ["lt", "lte", "gt", "gte", "between"] },
        "value": {
          "oneOf": [
            { "type": "number" },
            { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }
          ]
        },
        "unit": { "type": "string", "minLength": 1 }
      },
      "if": { "properties": { "op": { "const": "between" } } },
      "then": { "properties": { "value": { "type": "array" } } },
      "else": { "properties": { "value": { "type": "number" } } },
      "additionalProperties": false
    },
    "medicationCriterion": {
      "allOf": [{ "$ref": "#/definitions/base" }],
      "required": ["rxnorm"],
      "properties": {
        "id": true, "type": true, "label": true, "source_text": true, "note": true,
        "group": true, "group_logic": true,
        "kind": { "const": "medication" },
        "rxnorm": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[0-9]+$" }
        }
      },
      "additionalProperties": false
    },
    "freeTextCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "text"],
      "properties": {
        "id": { "$ref": "#/definitions/criterionId" },
        "type": { "$ref": "#/definitions/criterionType" },
        "text": { "type": "string", "minLength": 1 }
      }
    }
  }
}
